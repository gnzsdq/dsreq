{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u5927\u5b66\u6bd5\u4e1a\u8bc1\u8865\u529e\uff0c\u5236\u4f5c\u4e0d\u540c\u5c42\u6b21\u7684\u6bd5\u4e1a\u8bc1","text":"<p>\u5728\u6c42\u804c\u8df3\u69fd\u3001\u8003\u516c\u8003\u7814\u3001\u804c\u79f0\u8bc4\u5ba1\u6216\u843d\u6237\u79ef\u5206\u65f6\uff0c\u5927\u5b66\u6bd5\u4e1a\u8bc1\u90fd\u662f\u4e0d\u53ef\u6216\u7f3a\u7684\u5b66\u5386\u6838\u5fc3\u51ed\u8bc1\u3002\u7136\u800c\uff0c\u73b0\u5b9e\u4e2d\u5e38\u6709\u6bd5\u4e1a\u751f\u56e0\u4fdd\u7ba1\u4e0d\u5584\u5bfc\u81f4\u8bc1\u4e66\u4e22\u5931\u6216\u635f\u6bc1\u3002\u9762\u5bf9\u8fd9\u4e00\u7a81\u53d1\u72b6\u51b5\uff0c\u4e86\u89e3\u5927\u5b66\u6bd5\u4e1a\u8bc1\u8865\u529e\u7684\u6cd5\u5b9a\u7a0b\u5e8f\uff0c\u4ee5\u53ca\u56fd\u5bb6\u5bf9\u4e0d\u540c\u5c42\u6b21\u7684\u6bd5\u4e1a\u8bc1\uff08\u5927\u4e13\u3001\u672c\u79d1\u3001\u7814\u7a76\u751f\u7b49\uff09\u5728\u5370\u5236\u3001\u7ba1\u7406\u4e0e\u6838\u9a8c\u4e0a\u7684\u89c4\u8303\u5dee\u5f02\uff0c\u663e\u5f97\u5c24\u4e3a\u91cd\u8981\u3002</p> <p></p> <p>\u672c\u6587\u5c06\u4e3a\u60a8\u6df1\u5ea6\u89e3\u6790\u9ad8\u6821\u6bd5\u4e1a\u8bc1\u4e66\u7684\u5b98\u65b9\u8865\u529e\u6d41\u7a0b\u3001\u9632\u4f2a\u5de5\u827a\u7279\u5f81\uff0c\u5e76\u89e3\u7b54\u5b66\u5386\u7ba1\u7406\u4e2d\u7684\u6838\u5fc3\u6cd5\u5f8b\u5e38\u8bc6\uff0c\u52a9\u60a8\u5408\u89c4\u3001\u9ad8\u6548\u5730\u89e3\u51b3\u5b66\u5386\u8bc1\u660e\u95ee\u9898\u3002</p>"},{"location":"#_2","title":"\u4e00\u3001 \u5927\u5b66\u6bd5\u4e1a\u8bc1\u4e22\u5931\uff0c\u80fd\u76f4\u63a5\u539f\u6837\u201c\u8865\u529e\u201d\u5417\uff1f","text":"<p>\u6839\u636e\u6559\u80b2\u90e8\u300a\u666e\u901a\u9ad8\u7b49\u5b66\u6821\u5b66\u751f\u7ba1\u7406\u89c4\u5b9a\u300b\u7b2c\u4e09\u5341\u516b\u6761\u660e\u786e\u89c4\u5b9a\uff1a\u6bd5\u4e1a\u8bc1\u4e66\u9057\u5931\u6216\u8005\u635f\u574f\uff0c\u7ecf\u672c\u4eba\u7533\u8bf7\uff0c\u5b66\u6821\u6838\u5b9e\u540e\u5e94\u5f53\u51fa\u5177\u76f8\u5e94\u7684\u201c\u6bd5\u4e1a\u8bc1\u660e\u4e66\u201d\u3002</p> <ul> <li>\u6cd5\u5f8b\u6548\u529b\u5b8c\u5168\u7b49\u540c\uff1a \u6bd5\u4e1a\u8bc1\u660e\u4e66\u5177\u6709\u4e0e\u539f\u6bd5\u4e1a\u8bc1\u4e66\u540c\u7b49\u7684\u6cd5\u5f8b\u6548\u529b\u3002</li> <li>\u5b57\u6837\u533a\u522b\uff1a \u8bc1\u660e\u4e66\u4e0a\u4f1a\u660e\u786e\u6807\u6ce8\u201c\u6bd5\u4e1a\u8bc1\u660e\u4e66\u201d\u5b57\u6837\uff0c\u5e76\u6ce8\u660e\u539f\u6bd5\u4e1a\u8bc1\u4e66\u7f16\u53f7\u3002</li> <li>\u552f\u4e00\u6027\uff1a \u9ad8\u6821\u4e0d\u80fd\u91cd\u65b0\u5f00\u5177\u539f\u6837\u3001\u539f\u7f16\u53f7\u7684\u201c\u6bd5\u4e1a\u8bc1\u201d\u539f\u4ef6\uff0c\u53ea\u80fd\u4f9d\u6cd5\u6838\u53d1\u6bd5\u4e1a\u8bc1\u660e\u4e66\u3002</li> </ul>"},{"location":"#_3","title":"\u4e8c\u3001 \u5236\u4f5c\u4e0e\u5212\u5206\uff1a\u4e0d\u540c\u5c42\u6b21\u7684\u6bd5\u4e1a\u8bc1\u6709\u54ea\u4e9b\u6838\u5fc3\u533a\u522b\uff1f","text":"<p>\u5728\u9ad8\u7b49\u6559\u80b2\u4f53\u7cfb\u4e2d\uff0c\u56fd\u5bb6\u5bf9\u4e0d\u540c\u5c42\u6b21\u7684\u6bd5\u4e1a\u8bc1\uff08\u5982\u4e13\u79d1\u3001\u672c\u79d1\u3001\u7855\u58eb\u7814\u7a76\u751f\u3001\u535a\u58eb\u7814\u7a76\u751f\uff09\u6709\u7740\u4e25\u683c\u7684\u7248\u5f0f\u3001\u5185\u5bb9\u4e0e\u5236\u4f5c\u89c4\u8303\u3002\u5728\u767e\u5ea6\u6216\u8c37\u6b4c\u56fe\u7247\u4e2d\u641c\u7d22\u6bd5\u4e1a\u8bc1\u6837\u672c\u65f6\uff0c\u6211\u4eec\u53ef\u4ee5\u6e05\u6670\u5730\u770b\u5230\u4ee5\u4e0b\u591a\u5c42\u6b21\u7684\u7279\u5f81\u5dee\u5f02\uff1a</p>"},{"location":"#1","title":"1. \u4e13\u79d1\uff08\u5927\u4e13\uff09\u6bd5\u4e1a\u8bc1\u4e66","text":"<ul> <li>\u5b66\u5236\u7279\u5f81\uff1a \u8bc1\u4e66\u5185\u9875\u4f1a\u660e\u786e\u6807\u6ce8\u201c\u4fee\u4e1a\u671f\u6ee1\uff0c\u51c6\u4e88\u6bd5\u4e1a\u201d\uff0c\u5b66\u5236\u901a\u5e38\u4e3a\u4e09\u5e74\u6216\u4e24\u5e74\u3002</li> <li>\u6838\u5fc3\u5185\u5bb9\uff1a \u5305\u542b\u5b66\u751f\u59d3\u540d\u3001\u6027\u522b\u3001\u51fa\u751f\u65e5\u671f\u3001\u4e13\u4e1a\u540d\u79f0\u3001\u5b66\u6821\u516c\u7ae0\u53ca\u6821\u957f\u7b7e\u7ae0\u3002</li> </ul>"},{"location":"#2","title":"2. \u672c\u79d1\uff08\u5927\u5b66\u672c\u79d1\uff09\u6bd5\u4e1a\u8bc1\u4e66","text":"<ul> <li>\u5b66\u5236\u4e0e\u53cc\u8bc1\uff1a \u672c\u79d1\u5b66\u5236\u901a\u5e38\u4e3a\u56db\u5e74\uff08\u90e8\u5206\u533b\u5b66\u3001\u5efa\u7b51\u5b66\u4e3a\u4e94\u5e74\uff09\u3002\u4e0e\u4e13\u79d1\u4e0d\u540c\uff0c\u672c\u79d1\u7b26\u5408\u6761\u4ef6\u8005\u53ef\u540c\u65f6\u83b7\u5f97\u5b66\u58eb\u5b66\u4f4d\u8bc1\u4e66\uff08\u5b66\u4f4d\u8bc1\u4e0e\u6bd5\u4e1a\u8bc1\u76f8\u4e92\u72ec\u7acb\uff0c\u7edf\u79f0\u201c\u53cc\u8bc1\u201d\uff09\u3002</li> <li>\u8bc1\u4e66\u7f16\u53f7\uff1a \u8bc1\u4e66\u53f3\u4e0b\u89d2\u7684\u5b66\u6821\u7f16\u53f7\u4e0e\u5b66\u4fe1\u7f51\uff08CHSI\uff09\u552f\u4e00\u5bf9\u5e94\uff0c\u5177\u6709\u4e25\u5bc6\u7684\u6392\u4ed6\u6027\u3002</li> </ul>"},{"location":"#3","title":"3. \u7814\u7a76\u751f\uff08\u7855\u58eb/\u535a\u58eb\uff09\u6bd5\u4e1a\u8bc1\u4e66","text":"<ul> <li>\u7248\u5f0f\u89c4\u683c\uff1a \u7814\u7a76\u751f\u5b66\u5386\u5c42\u6b21\u66f4\u9ad8\uff0c\u5176\u6bd5\u4e1a\u8bc1\u6837\u5f0f\u5728\u89c6\u89c9\u8bbe\u8ba1\u4e0a\u901a\u5e38\u6bd4\u666e\u901a\u672c\u4e13\u79d1\u66f4\u4e3a\u5e84\u91cd\u3002\u5185\u9875\u4f1a\u660e\u786e\u5199\u6709\u201c\u653b\u8bfbXX\u5b66\u79d1\u7855\u58eb/\u535a\u58eb\u5b66\u4f4d\u201d\u6216\u201c\u7814\u7a76\u751f\u5b66\u6bb5\u4fee\u4e1a\u671f\u6ee1\u201d\u3002</li> <li>\u53cc\u8f68\u5236\u7ba1\u7406\uff1a \u540c\u6837\u5206\u4e3a\u6bd5\u4e1a\u8bc1\u4e66\uff08\u5b66\u5386\uff09\u4e0e\u7855\u58eb/\u535a\u58eb\u5b66\u4f4d\u8bc1\u4e66\uff08\u5b66\u4f4d\uff09\u3002</li> </ul>"},{"location":"#_4","title":"\u4e09\u3001 \u89c4\u8303\u7684\u5927\u5b66\u6bd5\u4e1a\u8bc1\u8865\u529e\uff08\u6bd5\u4e1a\u8bc1\u660e\u4e66\uff09\u6d41\u7a0b","text":"<p>\u5f53\u60a8\u9762\u4e34\u5b66\u5386\u8bc1\u4e66\u4e22\u5931\u65f6\uff0c\u5207\u52ff\u8f7b\u4fe1\u6240\u8c13\u7684\u201c\u5feb\u901f\u539f\u6837\u539f\u7248\u5b9a\u5236\u201d\uff0c\u800c\u5e94\u901a\u8fc7\u4ee5\u4e0b\u5b98\u65b9\u89c4\u8303\u9014\u5f84\u5411\u539f\u6bd5\u4e1a\u9662\u6821\u7533\u8bf7\u8865\u529e\uff1a</p> <ol> <li>\u51c6\u5907\u7533\u8bf7\u6750\u6599\uff1a<ul> <li>\u672c\u4eba\u8eab\u4efd\u8bc1\u539f\u4ef6\u53ca\u590d\u5370\u4ef6\u3002</li> <li>\u4e24\u5f20\u8fd1\u671f\u514d\u51a0\u84dd\u5e95\u6216\u7ea2\u5e95\u4e24\u5bf8\u7167\u7247\uff08\u90e8\u5206\u9ad8\u6821\u8981\u6c42\u63d0\u4f9b\u4e0e\u539f\u6bd5\u4e1a\u8bc1\u540c\u5e95\u7684\u7167\u7247\u7535\u5b50\u7248\uff09\u3002</li> <li>\u5b66\u4fe1\u7f51\uff08CHSI\uff09\u6253\u5370\u7684\u300a\u6559\u80b2\u90e8\u5b66\u5386\u8bc1\u4e66\u7535\u5b50\u6ce8\u518c\u5907\u6848\u8868\u300b\u3002</li> </ul> </li> <li>\u6863\u6848\u5e93\u68c0\u7d22\u6838\u5b9e\uff1a \u524d\u5f80\u539f\u6bd5\u4e1a\u5b66\u6821\u7684\u6863\u6848\u5ba4\uff08\u6216\u6559\u52a1\u5904\uff09\uff0c\u63d0\u53d6\u5f53\u5e74\u7684\u5f55\u53d6\u540d\u518c\u3001\u6bd5\u4e1a\u751f\u767b\u8bb0\u8868\u53ca\u6210\u7ee9\u5355\u590d\u5370\u4ef6\u5e76\u52a0\u76d6\u5b66\u6821\u516c\u7ae0\u3002</li> <li>\u5b66\u6821\u5ba1\u6838\u4e0e\u5236\u8bc1\uff1a \u6559\u52a1\u5904\u6216\u5b66\u751f\u5904\u5bf9\u6750\u6599\u8fdb\u884c\u4e25\u683c\u5ba1\u6838\u3002\u786e\u8ba4\u65e0\u8bef\u540e\uff0c\u5b66\u6821\u4f1a\u6309\u7167\u6559\u80b2\u90e8\u7edf\u4e00\u89c4\u8303\uff0c\u5236\u4f5c\u5e76\u6838\u53d1\u6bd5\u4e1a\u8bc1\u660e\u4e66\uff0c\u5e76\u62a5\u6559\u80b2\u884c\u653f\u90e8\u95e8\u5907\u6848\u3002</li> </ol>"},{"location":"#_5","title":"\u56db\u3001 \u6570\u5b57\u5316\u65f6\u4ee3\uff1a\u5b66\u4fe1\u7f51\u7684\u201c\u7535\u5b50\u6bd5\u4e1a\u8bc1\u201d","text":"<p>\u968f\u7740\u5168\u56fd\u9ad8\u7b49\u6559\u80b2\u6570\u5b57\u5316\u5efa\u8bbe\u7684\u5b8c\u5584\uff0c\u4f20\u7edf\u7684\u7eb8\u8d28\u201c\u5927\u7ea2\u672c\u201d\u6216\u6bd5\u4e1a\u8bc1\u539f\u4ef6\u5df2\u4e0d\u518d\u662f\u552f\u4e00\u7684\u9a8c\u8bc1\u6e20\u9053\u3002</p> <ul> <li>\u5b66\u4fe1\u7f51\u7ec8\u8eab\u67e5\u9a8c\uff1a \u56fd\u5bb6\u5b9e\u884c\u9ad8\u7b49\u6559\u80b2\u5b66\u5386\u8bc1\u4e66\u7535\u5b50\u6ce8\u518c\u5236\u5ea6\u3002\u65e0\u8bba\u662f\u4e13\u79d1\u3001\u672c\u79d1\u8fd8\u662f\u7814\u7a76\u751f\uff0c\u6240\u6709\u7684\u5b66\u5386\u4fe1\u606f\u5747\u6c38\u4e45\u8bb0\u5f55\u5728\u4e2d\u56fd\u9ad8\u7b49\u6559\u80b2\u5b66\u751f\u4fe1\u606f\u7f51\uff08\u5b66\u4fe1\u7f51\uff09\u4e2d\u3002</li> <li>\u7535\u5b50\u5907\u6848\u8868\uff1a \u5728\u5b9e\u9645\u5e94\u7528\uff08\u5982\u4f01\u4e1a\u5165\u804c\u5ba1\u67e5\u3001\u5404\u79cd\u8003\u8bd5\u62a5\u540d\uff09\u4e2d\uff0c\u4e0b\u8f7d\u5e76\u51fa\u793a\u5e26\u6709\u52a8\u6001\u4e8c\u7ef4\u7801\u7684\u300a\u6559\u80b2\u90e8\u5b66\u5386\u8bc1\u4e66\u7535\u5b50\u6ce8\u518c\u5907\u6848\u8868\u300b\uff0c\u5176\u6548\u7387\u548c\u8ba4\u53ef\u5ea6\u5f80\u5f80\u9ad8\u4e8e\u7eb8\u8d28\u539f\u4ef6\u3002</li> </ul>"},{"location":"#_6","title":"\u4e94\u3001 \u603b\u7ed3\u4e0e\u98ce\u9669\u63d0\u793a","text":"<p>\u59a5\u5584\u4fdd\u7ba1\u548c\u5408\u89c4\u8865\u529e\u5927\u5b66\u6bd5\u4e1a\u8bc1\uff0c\u662f\u4fdd\u62a4\u81ea\u8eab\u5b66\u4e60\u6210\u679c\u4e0e\u5408\u6cd5\u6743\u76ca\u7684\u57fa\u77f3\u3002</p> <p>\u4e25\u6b63\u6cd5\u5f8b\u58f0\u660e\uff1a \u5927\u5b66\u6bd5\u4e1a\u8bc1\u4e66\u548c\u5b66\u4f4d\u8bc1\u4e66\u7531\u56fd\u5bb6\u6559\u80b2\u90e8\u7edf\u7b79\uff0c\u5e76\u7531\u5404\u9ad8\u6821\u4f9d\u6cd5\u6838\u53d1\u3002\u7531\u4e8e\u5b66\u5386\u8bc1\u4e66\u5177\u5907\u6781\u9ad8\u7684\u793e\u4f1a\u4fe1\u7528\u8d44\u4ea7\u5c5e\u6027\uff0c\u4efb\u4f55\u79c1\u81ea\u5236\u9020\u3001\u4e70\u5356\u3001\u4f2a\u9020\u6216\u6d82\u6539\u4e0d\u540c\u5c42\u6b21\u6bd5\u4e1a\u8bc1\u7684\u884c\u4e3a\uff0c\u5747\u89e6\u72af\u300a\u4e2d\u534e\u4eba\u6c11\u5171\u548c\u56fd\u5211\u6cd5\u300b\u7b2c\u4e8c\u767e\u516b\u5341\u6761\uff0c\u6d89\u5acc\u6784\u6210\u201c\u4f2a\u9020\u3001\u53d8\u9020\u3001\u4e70\u5356\u56fd\u5bb6\u673a\u5173\u516c\u6587\u3001\u8bc1\u4ef6\u3001\u5370\u7ae0\u7f6a\u201d\u3002\u5404\u7528\u4eba\u5355\u4f4d\u3001\u843d\u6237\u5ba1\u6279\u90e8\u95e8\u5747\u901a\u8fc7\u5b66\u4fe1\u7f51\u5185\u90e8\u7cfb\u7edf\u5bf9\u5b66\u5386\u8fdb\u884c\u5b9e\u65f6\u6838\u9a8c\uff0c\u5207\u52ff\u5fc3\u5b58\u4fa5\u5e78</p>"}]}